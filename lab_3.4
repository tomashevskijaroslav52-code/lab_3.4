#include <iostream>
#include <cmath>

using namespace std;

int main() {
    double x;
    double y;
    double R;

    cout << "R = "; cin >> R;
    cout << "x = "; cin >> x;
    cout << "y = "; cin >> y;

    if ((x >= -R && x <= 0 && y >= 0 && y <= R && (x + R) * (x + R) + (y - R) * (y - R) >= R * R) ||
        (x >= 0 && y <= 0 && x * x + y * y <= R * R))
    {
        cout << "yes" << endl;
    }
    else
    {
        cout << "no" << endl;
    }

    return 0;
}
